# Python caches and build artifacts
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# Environments and local configuration
.venv*/
venv/
env/
.env
.env.*
!.env.example
cnn/.external_inference.env

# Local experiments, downloads and model weights
runs/
.cache/
wandb/
*.pt
*.pth
*.ckpt
*.safetensors

# Audio is distributed through the published datasets
*.wav
*.aif
*.aiff
*.flac
*.mp3

# Published results retain summaries, not prediction/bootstrap arrays
/experiments/benchmark/results/**/*.npz
/experiments/finetuning/results/**/*.npz

# Keep the two published figures; ignore other generated figure artifacts
/datasets_figures/output/*
!/datasets_figures/output/fig_dataset_overview.pdf
!/datasets_figures/output/fig_dataset_overview.png
!/datasets_figures/output/fig_classification_overview.pdf
!/datasets_figures/output/fig_classification_overview.png

